<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Prepni.Core\Prepni.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\assets\prepni.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Native AOT: jeden malý exe bez .NET runtime, rychlý start a málo paměti pro aplikaci, která běží celý den. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>

    <Version>0.1.0</Version>
    <Product>Přepni</Product>
    <Description>Dvakrát Shift přepíše text napsaný ve špatném rozložení klávesnice.</Description>
    <Authors>Martin Hájek</Authors>
    <Copyright>© 2026 Martin Hájek</Copyright>
  </PropertyGroup>

</Project>
